# Ray cluster template for AWS-backed Tessera embedding inference.
#
# Provider-injected fields are flagged below as `# INJECT: <what>`. The AWS
# Ray provider (`providers/aws/ray.py::_resolve_ray_config`) reads runtime
# values from SSM Parameter Store and writes a resolved copy of this file
# to a tempfile before calling `ray up`. This template should not contain
# any AWS-specific account-bound IDs (security groups, AMIs, IAM roles,
# subnet IDs, key pair names) — those are environment-specific and live
# in SSM.
#
# What you'll typically customise per-deployment:
#   - `cluster_name`: prefix for EC2 ray-cluster-name tags
#   - `provider.region`: AWS region (must match SSM region)
#   - `available_node_types[*].node_config.InstanceType`: head and worker
#     instance types (the defaults assume an L40S GPU with 48 GB VRAM —
#     `g6e.xlarge` for workers, `m5.2xlarge` for the head)
#   - `min_workers` / `max_workers`: pool sizing
#   - `idle_timeout_minutes`: autoscaler idle-down delay
#
# What you should not have to change:
#   - `provider.type: aws` (this template is AWS-specific)
#   - `provider.use_internal_ips: true` (private-subnet deployment)
#   - `provider.cache_stopped_nodes: false` (terminate, don't stop)
#
# A custom AMI with Python 3.12, a venv, and the inference deps
# pre-installed (built by the user's own Packer pipeline) is strongly
# recommended — runtime `pip install` of torch + ray on every worker
# bottlenecks at scale. See `providers/aws/gotchas.md` for the AMI
# baking pattern.

cluster_name: tessera-inference  # INJECT: overridden at runtime to allow concurrent clusters
max_workers: 500  # Global ceiling — Ray defaults to 2 if omitted!

provider:
    type: aws
    region: us-west-2  # Default matches OPERA RTC archive region (in-region auth required)
    # INJECT: availability_zone — comma-joined AZs of ALL private subnets, in
    # SSM order. Nodes launch in the first-listed subnet and fail over to the
    # next on capacity errors. Cross-AZ spread is safe for this workload: bulk
    # data is actor↔S3 only (never node-to-node); head↔worker is control RPCs.
    use_internal_ips: true  # Workers launch in private subnets (no public IPs)
    cache_stopped_nodes: false  # Terminate (not stop) nodes — flow runner lacks ec2:StopInstances

auth:
    ssh_user: ubuntu
    # INJECT: ssh_private_key — path to a tempfile written from the SSH key
    # material stored in SSM at /ec2/keypair/{key_pair_id}.

available_node_types:
    # Head node runs the GCS (Global Control Store) and coordinates all
    # scheduling. At 100+ workers, GCS heartbeat processing, object directory
    # lookups, and task metadata scale with node count. m5.2xlarge (8 vCPU,
    # 32 GB) provides headroom up to ~200 workers; bump to m5.4xlarge for 500.
    head:
        node_config:
            InstanceType: m5.2xlarge
            # INJECT: ImageId — custom AMI from the AMI SSM parameter
            # INJECT: KeyName — SSH key pair name from SSM
            # INJECT: SecurityGroupIds — VPC security group from SSM
            # INJECT: IamInstanceProfile — instance profile ARN from SSM
            # INJECT: SubnetIds — single private subnet from SSM (pinned to one AZ)
            # INJECT: TagSpecifications — caller-defined EC2 tags
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
        min_workers: 0
        max_workers: 0

    # On-demand GPU workers (~$1.86/hr at us-west-2 g6e.xlarge pricing)
    # min_workers MUST stay 0: the idle timeout only drains nodes ABOVE the
    # floor, so a positive floor is held forever on a leaked cluster — a
    # cancelled flow whose teardown never ran kept a head + 2 idle g6e.xlarge
    # overnight (2026-07-16). The cost of 0 is one ~30-60s autoscaler
    # cold-start for the first batch of actors.
    gpu-workers-ondemand:
        node_config:
            InstanceType: g6e.xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 4
            GPU: 1
        min_workers: 0
        max_workers: 500

    # Spot GPU workers (experimental — risk of interruption mid-chunk).
    # Set max_workers > 0 to enable.
    gpu-workers-spot:
        node_config:
            InstanceType: g6e.xlarge
            InstanceMarketOptions:
                MarketType: spot
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 4
            GPU: 1
        min_workers: 0
        max_workers: 0

head_node_type: head

idle_timeout_minutes: 2
upscaling_speed: 2.0  # Cluster can add 2x current nodes per autoscaling round

# Setup commands assume a custom AMI with Python + venv + dependencies
# pre-installed. The placeholder substitution lets the provider point
# workers at a versioned tarball of the package source code in S3.
#
# {CODE_BUCKET}: S3 bucket name (without s3:// prefix). REPLACED at
#                runtime when a `code_bucket` is given. With none, the
#                provider DROPS the whole command — an unsubstituted
#                bucket name is a copy that fails and takes node setup
#                with it — and workers use the code baked into the AMI.
# {CODE_SUFFIX}: optional filename suffix (e.g. `-mybranch`); REPLACED
#                at runtime. Empty string for production tarballs.
#
# CloudWatch agent setup is INJECTed by the AWS provider from
# `providers/aws/cloudwatch-agent.json.tpl` (heredocs in YAML break over
# SSH due to indented terminators).
setup_commands:
    - aws s3 cp s3://{CODE_BUCKET}/code/src{CODE_SUFFIX}.tar.gz /tmp/src.tar.gz && mkdir -p ~/tessera-embeddings && tar -xzf /tmp/src.tar.gz -C ~/tessera-embeddings/ && rm /tmp/src.tar.gz
    - echo 'export PATH=/opt/tessera/venv/bin:$PATH' >> ~/.bashrc && echo 'export PYTHONPATH=$HOME/tessera-embeddings:$PYTHONPATH' >> ~/.bashrc

head_setup_commands: []
worker_setup_commands: []

# Ray start commands activate the pre-installed venv at /opt/tessera/venv.
# Adjust the venv path if your AMI puts it elsewhere.
#
# INJECT: launch-pacing environment — when the caller asks for it, the provider
# assigns LAUNCH_PACING_ENV on the head's `ray start` invocation below, so the
# autoscaler it spawns paces its EC2 launch requests against the account's shared
# RunInstances quota. Head only: a worker runs no autoscaler. The assignments must
# ride on the `ray start` command itself — Ray runs each entry as its own shell
# command over SSH, so an `export` on its own line reaches nothing.
head_start_ray_commands:
    - ray stop
    - ulimit -n 65536 && PYTHONPATH=$HOME/tessera-embeddings ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml --dashboard-host=0.0.0.0
worker_start_ray_commands:
    - ray stop
    - ulimit -n 65536 && PYTHONPATH=$HOME/tessera-embeddings ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076
