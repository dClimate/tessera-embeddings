# Ray cluster template for AWS-backed Tessera embedding inference.
#
# Provider-injected fields are flagged below as `# INJECT: <what>`. The AWS
# Ray provider (`providers/aws/ray.py::_resolve_ray_config`) reads runtime
# values from SSM Parameter Store and writes a resolved copy of this file
# to a tempfile before calling `ray up`. This template should not contain
# any AWS-specific account-bound IDs (security groups, AMIs, IAM roles,
# subnet IDs, key pair names) — those are environment-specific and live
# in SSM.
#
# What you'll typically customise per-deployment:
#   - `cluster_name`: prefix for EC2 ray-cluster-name tags
#   - `provider.region`: AWS region (must match SSM region)
#   - `available_node_types[*].node_config.InstanceType`: head and worker
#     instance types (the defaults assume an L40S GPU with 45,776 MiB =
#     44.7 GiB = 48.0 GB of VRAM — `g6e.xlarge` for workers, `m5.2xlarge`
#     for the head). Two CAPACITY-FALLBACK rungs ship at `max_workers: 0`;
#     open one with the campaign's `gpu_fallback_cards` parameter, or name it
#     in the `gpu-worker-ladder` SSM key, rather than editing here.
#   - `min_workers` / `max_workers`: pool sizing
#   - `idle_timeout_minutes`: autoscaler idle-down delay
#
# What you should not have to change:
#   - `provider.type: aws` (this template is AWS-specific)
#   - `provider.use_internal_ips: true` (private-subnet deployment)
#   - `provider.cache_stopped_nodes: false` (terminate, don't stop)
#
# Nodes run from a prebuilt Python environment: an image mounted at
# /opt/tessera (`setup_commands` below), or a venv baked into the AMI.
# Runtime `pip install` of torch + ray on every worker bottlenecks at
# scale. See `providers/aws/gotchas.md`, "Worker image".

cluster_name: tessera-inference  # INJECT: overridden at runtime to allow concurrent clusters
max_workers: 500  # Global ceiling — Ray defaults to 2 if omitted!

provider:
    type: aws
    region: us-west-2  # Default matches OPERA RTC archive region (in-region auth required)
    # INJECT: availability_zone — comma-joined AZs of ALL private subnets, in
    # SSM order. Nodes launch in the first-listed subnet and fail over to the
    # next on capacity errors. Cross-AZ spread is safe for this workload: bulk
    # data is actor↔S3 only (never node-to-node); head↔worker is control RPCs.
    use_internal_ips: true  # Workers launch in private subnets (no public IPs)
    cache_stopped_nodes: false  # Terminate (not stop) nodes — flow runner lacks ec2:StopInstances

auth:
    ssh_user: ubuntu
    # INJECT: ssh_private_key — path to a tempfile written from the SSH key
    # material stored in SSM at /ec2/keypair/{key_pair_id}.

available_node_types:
    # Head node runs the GCS (Global Control Store) and coordinates all
    # scheduling. At 100+ workers, GCS heartbeat processing, object directory
    # lookups, and task metadata scale with node count. m5.2xlarge (8 vCPU,
    # 32 GB) provides headroom up to ~200 workers; bump to m5.4xlarge for 500.
    head:
        node_config:
            InstanceType: m5.2xlarge
            # INJECT: ImageId — custom AMI from the AMI SSM parameter
            # INJECT: KeyName — SSH key pair name from SSM
            # INJECT: SecurityGroupIds — VPC security group from SSM
            # INJECT: IamInstanceProfile — instance profile ARN from SSM
            # INJECT: SubnetIds — single private subnet from SSM (pinned to one AZ)
            # INJECT: TagSpecifications — caller-defined EC2 tags
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
        min_workers: 0
        max_workers: 0

    # On-demand GPU workers (~$1.86/hr at us-west-2 g6e.xlarge pricing)
    # min_workers MUST stay 0: the idle timeout only drains nodes ABOVE the
    # floor, so a positive floor is held forever on a leaked cluster — a
    # cancelled flow whose teardown never ran kept a head + 2 idle g6e.xlarge
    # overnight (2026-07-16). The cost of 0 is one ~30-60s autoscaler
    # cold-start for the first batch of actors.
    gpu-workers-ondemand:
        node_config:
            InstanceType: g6e.xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 4
            GPU: 1
            tessera_rung:g6e.xlarge: 1
        min_workers: 0
        max_workers: 500

    # --- CAPACITY FALLBACK rungs, INERT as shipped -----------------------
    #
    # Both ship at `max_workers: 0`, which makes a rung completely unreachable to the
    # autoscaler. Merging them therefore changes nothing about a campaign in flight.
    # They are opened by the `gpu_fallback_instance_types` campaign parameter — see
    # `ray.py::_apply_gpu_fallback` — one at a time, refused at both the campaign
    # parameter and the provider.
    #
    # WHY A FALLBACK IS NEEDED AT ALL. A single instance type is a single capacity
    # pool. Measured in us-west-2 on 2026-08-27, every `g6e` size refused with
    # `InsufficientInstanceCapacity` in all three of our AZs at the same moment, while
    # `g6.xlarge`, `g6.2xlarge` and `g5.xlarge` launched. Ray cannot express a fallback
    # type list of its own: its node provider passes ONE `InstanceType` to
    # `create_instances`, and only the SUBNET list rotates on retry.
    #
    # WHY OPENING A RUNG IS NOT ENOUGH. Ray picks node types greedily and stops choosing
    # one only when THAT type's `max_workers` is exhausted, so while demand stays under
    # the production ceiling an open fallback is never asked for at all — measured on dev
    # 2026-08-28 as 18 consecutive L40S attempts, all refused, and zero A10G attempts.
    # `fleet_mix.py` states how many of each card to hold, which autoscaler v2 satisfies
    # in the same pass as actor demand. Neither half works alone.
    #
    # EACH on-demand GPU rung declares `tessera_rung:<instance-type>: 1`. That marker is
    # how a fleet-mix request addresses ONE rung. It is ours rather than Ray's autofilled
    # `accelerator_type:<CARD>` because the card is not unique — the spot rung below is
    # the same `g6e.xlarge`, so a card-named request could be satisfied by INTERRUPTIBLE
    # capacity. The spot rung deliberately carries no marker.
    #
    # WHY THE `2xlarge` OF EACH FAMILY. Host RAM, not price. The vCPU-matched
    # `g5.xlarge` and `g6.xlarge` carry 16 GiB against a measured ~17.7 GB per-actor
    # requirement — the exact shape that OOMed the loader before inference on the
    # earlier 16 GB g5-class workers. The `2xlarge` gives 32 GiB, matching `g6e.xlarge`.
    #
    # WHAT THAT COSTS. The G-and-VT quota is counted in vCPU, and these sizes are 8 vCPU
    # per GPU against `g6e.xlarge`'s 4 — so a fallback GPU spends TWICE the quota of a
    # production one. At the applied 10,000 vCPU that is 2,500 L40S or 1,250 A10G. A
    # fleet fully on fallback is half the card count, before any throughput difference.
    #
    # WHICH CARD. Measured on one cluster, same minutes, same work: against the L40S the
    # A10G reaches 0.46 and the L4 0.32 of its throughput. Both cost more per unit of
    # work than what we already run, so neither is a preferred type — but an idle fleet
    # costs infinitely more per token, which is what makes the A10G worth opening under
    # capacity pressure. The L4 ships here so the ladder can name it, and is NOT
    # recommended. Full comparison: `context_docs/inference/inference-on-gpus.md` §4.
    #
    # EVERY rung DECLARES `resources:`, including these inert ones, and it is not
    # optional. Ray's schema lists `resources` as REQUIRED; it autofills the block from
    # the live EC2 catalogue, but that autodetection is wrapped in a bare
    # `except Exception` that downgrades failure to a WARNING, and `validate_config` then
    # rejects a node type with no `resources` key and fails the whole `ray up`. An
    # omission would make every cluster's bootstrap — including the `g6e.xlarge` the
    # campaign runs on — depend on one EC2 API call succeeding. A declared key overrides
    # autodetection silently, so `test_declared_resources_match_the_ec2_catalogue` checks
    # every block against a captured `DescribeInstanceTypes` response.

    # NVIDIA A10G, 22,888 MiB. Ampere (SM 8.6) against the L40S's Ada (8.9); x86_64 and
    # the same CUDA regime, so the L40S AMI boots unchanged and bf16 autocast is native.
    # THE capacity fallback: 0.46 of an L40S, the best of the alternatives measured.
    gpu-workers-ondemand-a10g-2xl:
        node_config:
            InstanceType: g5.2xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
            GPU: 1
            tessera_rung:g5.2xlarge: 1
        min_workers: 0
        max_workers: 0

    # NVIDIA L4, 22,888 MiB — same VRAM as the A10G, same Ada generation as the L40S.
    # Shipped so the ladder can name it; NOT a recommendation at 0.32 of an L40S.
    gpu-workers-ondemand-l4-2xl:
        node_config:
            InstanceType: g6.2xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
            GPU: 1
            tessera_rung:g6.2xlarge: 1
        min_workers: 0
        max_workers: 0

    gpu-workers-spot:
        node_config:
            InstanceType: g6e.xlarge
            InstanceMarketOptions:
                MarketType: spot
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 4
            GPU: 1
        min_workers: 0
        max_workers: 0

head_node_type: head

idle_timeout_minutes: 2
upscaling_speed: 2.0  # Cluster can add 2x current nodes per autoscaling round

# The placeholder substitution points nodes at a versioned tarball of the
# package source, and at the Python environment image, in S3.
#
# {CODE_BUCKET}: S3 bucket name (without s3:// prefix). REPLACED at
#                runtime when a `code_bucket` is given. With none, the
#                provider DROPS every command that names it — an
#                unsubstituted bucket name is a copy that fails and takes
#                node setup with it — and nodes use what the AMI carries.
# {CODE_SUFFIX}: optional filename suffix (e.g. `-mybranch`); REPLACED
#                at runtime. Empty string for production tarballs.
#
# The environment: Python 3.12 and every inference dependency, as an ext4 image that the node
# copies from S3 and mounts read-only at /opt/tessera, giving /opt/tessera/venv. Its URI is read
# from s3://{CODE_BUCKET}/code/env-image{CODE_SUFFIX}.uri, which the deployment writes beside the
# tarball, so a dependency change ships as a new image rather than a new AMI. The image goes on
# the instance store when the node has one (GPU workers; the DLAMI's boot service mounts it at
# /opt/dlami/nvme and can finish after Ray's setup begins, so the command waits up to 60 s), and
# on the root volume otherwise (the head). Any failure fails the node's setup. The command is a
# no-op on an AMI that carries its own venv at /opt/tessera/venv, which keeps such AMIs (and so
# each `ami_ssm_name_by_model` image, such as v1.1's PyTorch 2.5.1 one) on their baked venv.
# Measurements: context_docs/inference/fresh-worker-start.md.
#
# CloudWatch agent setup is INJECTed by the AWS provider from
# `providers/aws/cloudwatch-agent.json.tpl` (heredocs in YAML break over
# SSH due to indented terminators).
setup_commands:
    - mountpoint -q /opt/tessera || [ -e /opt/tessera/venv ] || { u=$(aws s3 cp --only-show-errors s3://{CODE_BUCKET}/code/env-image{CODE_SUFFIX}.uri -) || { echo "No environment image named at s3://{CODE_BUCKET}/code/env-image{CODE_SUFFIX}.uri" >&2; exit 1; }; d=/var/tmp; if lsblk -dno MODEL | grep -q 'Instance Storage' && timeout 60 sh -c 'until mountpoint -q /opt/dlami/nvme; do sleep 2; done'; then d=/opt/dlami/nvme; fi; sudo aws configure set default.s3.max_concurrent_requests 32 && sudo aws s3 cp --only-show-errors "$u" "$d/env.img" && sudo mkdir -p /opt/tessera && sudo mount -o loop,ro "$d/env.img" /opt/tessera; }
    - aws s3 cp s3://{CODE_BUCKET}/code/src{CODE_SUFFIX}.tar.gz /tmp/src.tar.gz && mkdir -p ~/tessera-embeddings && tar -xzf /tmp/src.tar.gz -C ~/tessera-embeddings/ && rm /tmp/src.tar.gz
    - echo 'export PATH=/opt/tessera/venv/bin:$PATH' >> ~/.bashrc && echo 'export PYTHONPATH=$HOME/tessera-embeddings:$PYTHONPATH' >> ~/.bashrc

head_setup_commands: []

# For an AMI that carries its own venv AND names an image of it in /opt/tessera/env-image.uri
# (yield-embeddings' AMIs baked before the environment left the AMI): the worker mounts that
# image read-only over the venv on the instance store. Any miss leaves the AMI's own venv in
# place. A no-op everywhere else.
worker_setup_commands:
    - mountpoint -q /opt/tessera/venv || { u=$(cat /opt/tessera/env-image.uri 2>/dev/null) && timeout 60 sh -c 'until mountpoint -q /opt/dlami/nvme; do sleep 2; done' && sudo aws configure set default.s3.max_concurrent_requests 32 && sudo aws s3 cp --only-show-errors "$u" /opt/dlami/nvme/venv.img && sudo mount -o loop,ro /opt/dlami/nvme/venv.img /opt/tessera/venv || true; }

# Ray start commands run Ray from the venv at /opt/tessera/venv (PATH, set above).
#
# INJECT: launch-pacing environment — when the caller asks for it, the provider
# assigns LAUNCH_PACING_ENV on the head's `ray start` invocation below, so the
# autoscaler it spawns paces its EC2 launch requests against the account's shared
# RunInstances quota. Head only: a worker runs no autoscaler. The assignments must
# ride on the `ray start` command itself — Ray runs each entry as its own shell
# command over SSH, so an `export` on its own line reaches nothing.
head_start_ray_commands:
    - ray stop
    - ulimit -n 65536 && PYTHONPATH=$HOME/tessera-embeddings ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml --dashboard-host=0.0.0.0
worker_start_ray_commands:
    - ray stop
    - ulimit -n 65536 && PYTHONPATH=$HOME/tessera-embeddings ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076
