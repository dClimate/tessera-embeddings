# Ray cluster template for AWS-backed Tessera embedding inference.
#
# Provider-injected fields are flagged below as `# INJECT: <what>`. The AWS
# Ray provider (`providers/aws/ray.py::_resolve_ray_config`) reads runtime
# values from SSM Parameter Store and writes a resolved copy of this file
# to a tempfile before calling `ray up`. This template should not contain
# any AWS-specific account-bound IDs (security groups, AMIs, IAM roles,
# subnet IDs, key pair names) — those are environment-specific and live
# in SSM.
#
# What you'll typically customise per-deployment:
#   - `cluster_name`: prefix for EC2 ray-cluster-name tags
#   - `provider.region`: AWS region (must match SSM region)
#   - `available_node_types[*].node_config.InstanceType`: head and worker
#     instance types (the defaults assume an L40S GPU with 45,776 MiB =
#     44.7 GiB = 48.0 GB of VRAM — `g6e.xlarge` for workers, `m5.2xlarge`
#     for the head). Two wider GPU rungs ship at `max_workers: 0`; release
#     one with the `gpu-worker-ladder` SSM key rather than editing here.
#   - `min_workers` / `max_workers`: pool sizing
#   - `idle_timeout_minutes`: autoscaler idle-down delay
#
# What you should not have to change:
#   - `provider.type: aws` (this template is AWS-specific)
#   - `provider.use_internal_ips: true` (private-subnet deployment)
#   - `provider.cache_stopped_nodes: false` (terminate, don't stop)
#
# A custom AMI with Python 3.12, a venv, and the inference deps
# pre-installed (built by the user's own Packer pipeline) is strongly
# recommended — runtime `pip install` of torch + ray on every worker
# bottlenecks at scale. See `providers/aws/gotchas.md` for the AMI
# baking pattern.

cluster_name: tessera-inference  # INJECT: overridden at runtime to allow concurrent clusters
max_workers: 500  # Global ceiling — Ray defaults to 2 if omitted!

provider:
    type: aws
    region: us-west-2  # Default matches OPERA RTC archive region (in-region auth required)
    # INJECT: availability_zone — comma-joined AZs of ALL private subnets, in
    # SSM order. Nodes launch in the first-listed subnet and fail over to the
    # next on capacity errors. Cross-AZ spread is safe for this workload: bulk
    # data is actor↔S3 only (never node-to-node); head↔worker is control RPCs.
    use_internal_ips: true  # Workers launch in private subnets (no public IPs)
    cache_stopped_nodes: false  # Terminate (not stop) nodes — flow runner lacks ec2:StopInstances

auth:
    ssh_user: ubuntu
    # INJECT: ssh_private_key — path to a tempfile written from the SSH key
    # material stored in SSM at /ec2/keypair/{key_pair_id}.

available_node_types:
    # Head node runs the GCS (Global Control Store) and coordinates all
    # scheduling. At 100+ workers, GCS heartbeat processing, object directory
    # lookups, and task metadata scale with node count. m5.2xlarge (8 vCPU,
    # 32 GB) provides headroom up to ~200 workers; bump to m5.4xlarge for 500.
    head:
        node_config:
            InstanceType: m5.2xlarge
            # INJECT: ImageId — custom AMI from the AMI SSM parameter
            # INJECT: KeyName — SSH key pair name from SSM
            # INJECT: SecurityGroupIds — VPC security group from SSM
            # INJECT: IamInstanceProfile — instance profile ARN from SSM
            # INJECT: SubnetIds — single private subnet from SSM (pinned to one AZ)
            # INJECT: TagSpecifications — caller-defined EC2 tags
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
        min_workers: 0
        max_workers: 0

    # On-demand GPU workers (~$1.86/hr at us-west-2 g6e.xlarge pricing)
    # min_workers MUST stay 0: the idle timeout only drains nodes ABOVE the
    # floor, so a positive floor is held forever on a leaked cluster — a
    # cancelled flow whose teardown never ran kept a head + 2 idle g6e.xlarge
    # overnight (2026-07-16). The cost of 0 is one ~30-60s autoscaler
    # cold-start for the first batch of actors.
    gpu-workers-ondemand:
        node_config:
            InstanceType: g6e.xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 4
            GPU: 1
        min_workers: 0
        max_workers: 500

    # --- Wider GPU rungs, INERT as shipped -------------------------------
    #
    # Both are `max_workers: 0`, which makes a rung completely unreachable to
    # the autoscaler: node-type choice in Ray 2.55.1 has no feedback from
    # capacity errors (`resource_demand_scheduler._resource_scores` takes a
    # `node_availability_summary` and never reads it), so `max_workers` is the
    # SOLE mechanism that moves it. Merging these therefore changes nothing
    # about a campaign in flight, and releasing one needs no code change — see
    # `gpu-worker-ladder` in `ray.py::_apply_gpu_worker_ladder`.
    #
    # They exist because a single instance type is a single capacity pool: a
    # fleet pinned to `g6e.xlarge` stalls at whatever us-west-2 will sell of
    # that one size, and Ray cannot express a fallback type list (its node
    # provider passes ONE `InstanceType` to `create_instances`; only the SUBNET
    # list rotates on retry). Every `g6e` size is the same L40S on x86_64, so
    # no AMI re-bake is involved in moving between them.
    #
    # EVERY rung DECLARES `resources:`, including the inert ones, and this is not
    # optional. Ray's config schema lists `resources` as REQUIRED. It autofills the
    # block from the live EC2 catalogue, but that autodetection is wrapped in a bare
    # `except Exception` that downgrades any failure to a WARNING
    # (`commands.py::_bootstrap_config`) — and `validate_config` then runs against a
    # node type that still has no `resources` key and fails the whole `ray up`.
    #
    # So an omitted block makes the cluster's bootstrap depend on one EC2 API call
    # succeeding: a throttled or denied `DescribeInstanceTypes`, or an instance type
    # absent from the configured region, takes down the launch of EVERY rung —
    # including the `g6e.xlarge` the campaign actually runs on. The call itself is
    # unconditional and predates these rungs; what an omission adds is a DEPENDENCE
    # on its success.
    #
    # A declared key does override autodetection, so a wrong vCPU or GPU count would
    # have the autoscaler scale against a fiction with no error. That risk is real
    # and is why omission was tried first; it is closed by
    # `test_declared_resources_match_the_ec2_catalogue`, which checks every declared
    # block against a captured `DescribeInstanceTypes` response.
    #
    # Read `available_node_types` order as a preference hint only. With the
    # actor bundle `{CPU: 1, GPU: 1}` Ray's scorer ties at 0 on its utilisation
    # term for every GPU type and falls through to the mean, where the GPU term
    # is just the count — so a multi-GPU rung SCORES HIGHER than `g6e.xlarge`
    # and demotes it to fallback. That is an arithmetic accident of one vendored
    # Ray file, and it is pinned by
    # `test_provider_aws_ray.py::TestRayNodeTypePreference`.

    # One L40S, 8 vCPU / 64 GiB — twice the CPU and RAM per GPU of the
    # `g6e.xlarge` at a ~30% per-GPU price premium, against the 7-15% of
    # GPU-hours a CPU-richer host can recover. The most quota-efficient rung
    # after `g6e.xlarge` (8 vCPU/GPU vs 4), and it carries no unmeasured risk:
    # still ONE actor per host, so every host-sharing question below is moot.
    gpu-workers-ondemand-2xl:
        node_config:
            InstanceType: g6e.2xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
            GPU: 1
        min_workers: 0
        max_workers: 0

    # Four L40S on one host, 48 vCPU / 384 GiB. FOUR actors share the box, which
    # is a configuration nothing in this repo had ever run before 2026-08-27 —
    # see `context_docs/design/gpu-host-packing-2026_08.md` for what the dev
    # measurement found. GPU, VRAM and PCIe are per-device and all bulk I/O goes
    # to S3, so the shared resources are host CPU (12 vCPU/actor, up from 4) and
    # the NIC (~950 MB/s per actor => ~30 Gbps for four, an order under the
    # host's). Least quota-efficient of the candidate sizes at 12 vCPU/GPU.
    gpu-workers-ondemand-12xl:
        node_config:
            InstanceType: g6e.12xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 48
            GPU: 4
        min_workers: 0
        max_workers: 0

    # --- L4 rungs, INERT as shipped, and a DIFFERENT capacity pool ------
    #
    # `g6.*` is the NVIDIA L4 at 22,888 MiB (22.4 GiB) — half the L40S's
    # 45,776 MiB. Same Ada Lovelace generation (SM 8.9) and same x86_64, so the
    # L40S AMI boots and runs on these unchanged; no re-bake.
    #
    # They exist because **the `g6e` family shares ONE capacity pool.** Measured
    # in us-west-2 on 2026-08-27: every `g6e` size from `xlarge` to `48xlarge`
    # refused with `InsufficientInstanceCapacity` in all three of our AZs at the
    # same moment, while `g6.xlarge`, `g6.2xlarge` and `g5.xlarge` launched. So
    # moving between `g6e` SIZES does not move to a different pool — the pool is
    # the CARD. Reaching a genuinely different pool means a different card.
    #
    # What makes a 22.4 GiB card arguable at all is the per-chunk peak-VRAM
    # measurement this branch added: `max_memory_allocated` is **7.5 GiB** on a
    # real chunk at B=7168, not the ~43 GiB the earlier nvidia-smi reading
    # implied. That reading was the caching allocator's RESERVED pool, which runs
    # 3x the live requirement and sizes itself to the card it is given.
    #
    # `g6.xlarge` is deliberately NOT offered: 16 GiB of host RAM against a
    # measured ~17.7 GB per-actor requirement is the exact shape that OOMed the
    # loader before inference on the earlier 16 GB g5-class workers.
    # `g6.2xlarge` gives 32 GiB, matching `g6e.xlarge`.
    #
    # NOT YET A PRODUCTION RECOMMENDATION. Per-GPU throughput on an L4 against
    # an L40S has not been measured, and the L4 is the smaller part in every
    # dimension. These rungs were shipped so the host-packing question could be
    # measured on hardware that could actually be rented.
    gpu-workers-ondemand-l4-2xl:
        node_config:
            InstanceType: g6.2xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
            GPU: 1
        min_workers: 0
        max_workers: 0

    # Four L4 on one host, 48 vCPU / 192 GiB — 12 vCPU and 48 GiB per actor,
    # the same per-actor shape as `g6e.12xlarge`. That is what makes it a valid
    # vehicle for the host-sharing question: the mechanism under test is four
    # actors contending for one host's CPU and NIC, and that is identical here.
    gpu-workers-ondemand-l4-12xl:
        node_config:
            InstanceType: g6.12xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 48
            GPU: 4
        min_workers: 0
        max_workers: 0

    # A larger L4 rung, for when `g6.2xlarge` itself has no capacity ---------
    #
    # 16 vCPU / 64 GiB / one L4. Shipped only as a capacity fallback for
    # `g6.2xlarge`: measured in us-west-2 on 2026-08-27, `g6.2xlarge` refused in
    # all three AZs at a moment when `g6.4xlarge` launched in two of them, so
    # size availability WITHIN a card family varies even though a hard shortage
    # takes the whole family down together. 16 vCPU per actor is four times the
    # `g6e.xlarge` baseline's CPU feed, which is worth up to 7-15% of GPU-hours
    # (`inference-perf-run-ledger.md`) — so a throughput figure measured here
    # FLATTERS the card relative to the production shape and must be reported
    # with that caveat.
    gpu-workers-ondemand-l4-4xl:
        node_config:
            InstanceType: g6.4xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 16
            GPU: 1
        min_workers: 0
        max_workers: 0

    # --- A10G rungs, INERT as shipped -----------------------------------
    #
    # `g5.*` is the NVIDIA A10G: 22,888 MiB (22.4 GiB), the SAME VRAM as the L4,
    # on the older Ampere generation (SM 8.6 against the L40S's and L4's 8.9).
    # x86_64 and within the same CUDA regime, so the L40S AMI boots and runs
    # unchanged; no re-bake. bfloat16 autocast is native on SM 8.0+.
    #
    # They exist to test ONE hypothesis that the L4 rungs cannot: that this
    # workload is limited by GPU MEMORY BANDWIDTH rather than by tensor
    # throughput. The two candidate cards are ordered OPPOSITELY on those two
    # axes, from the vendors' own datasheets:
    #
    #                 BF16 dense TFLOPS
    #     card    as quoted    FP32-accumulate    memory bandwidth
    #     L40S       362             181            864 GB/s
    #     L4         121              61            300 GB/s
    #     A10G        70              35            600 GB/s
    #
    # (Every one of these cards runs FP32 accumulation at HALF the rate its spec
    # sheet quotes, and autocast bf16 matmuls accumulate in FP32 — so the middle
    # column is the comparable one. See `_CARD_CEILINGS` in
    # `inference/profiling.py`.)
    #
    # The A10G is the decisive card because it is the ONLY one where the two
    # hypotheses disagree. Against the L40S, compute predicts 0.19x and
    # bandwidth 0.69x — a factor of 3.6 apart, and the break-even against
    # `g6e.xlarge`'s price sits between them. Against the L4 — twice the
    # bandwidth on 0.58x the compute — they predict opposite winners. The L4
    # alone cannot settle anything: compute predicts 0.33x of an L40S and
    # bandwidth 0.35x, indistinguishable, which is why the L4 measurement of
    # 0.27-0.34x is consistent with both. Fleet telemetry points at bandwidth
    # (SMACT ~0.99 with TENSO only 0.42-0.47), but that is an inference from two
    # counters, not a ranking.
    #
    # `g5.xlarge` is deliberately NOT offered, for the same reason `g6.xlarge`
    # is not: 16 GiB of host RAM against a measured ~17.7 GB per-actor
    # requirement. `g5.2xlarge` gives 32 GiB, matching `g6e.xlarge` exactly, and
    # is the shape to measure on. `g5.4xlarge` is its capacity fallback and
    # carries the same CPU-feed caveat as `g6.4xlarge` above.
    #
    # NOT A PRODUCTION RECOMMENDATION. Per-GPU throughput against an L40S is
    # what these rungs exist to measure.
    gpu-workers-ondemand-a10g-2xl:
        node_config:
            InstanceType: g5.2xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 8
            GPU: 1
        min_workers: 0
        max_workers: 0

    gpu-workers-ondemand-a10g-4xl:
        node_config:
            InstanceType: g5.4xlarge
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 16
            GPU: 1
        min_workers: 0
        max_workers: 0

    # Spot GPU workers (experimental — risk of interruption mid-chunk).
    # Set max_workers > 0 to enable.
    gpu-workers-spot:
        node_config:
            InstanceType: g6e.xlarge
            InstanceMarketOptions:
                MarketType: spot
            # INJECT: ImageId, KeyName, SecurityGroupIds, IamInstanceProfile,
            # SubnetIds, TagSpecifications (same set as head)
            BlockDeviceMappings:
                - DeviceName: /dev/sda1
                  Ebs:
                      VolumeSize: 80
                      VolumeType: gp3
        resources:
            CPU: 4
            GPU: 1
        min_workers: 0
        max_workers: 0

head_node_type: head

idle_timeout_minutes: 2
upscaling_speed: 2.0  # Cluster can add 2x current nodes per autoscaling round

# Setup commands assume a custom AMI with Python + venv + dependencies
# pre-installed. The placeholder substitution lets the provider point
# workers at a versioned tarball of the package source code in S3.
#
# {CODE_BUCKET}: S3 bucket name (without s3:// prefix). REPLACED at
#                runtime when a `code_bucket` is given. With none, the
#                provider DROPS the whole command — an unsubstituted
#                bucket name is a copy that fails and takes node setup
#                with it — and workers use the code baked into the AMI.
# {CODE_SUFFIX}: optional filename suffix (e.g. `-mybranch`); REPLACED
#                at runtime. Empty string for production tarballs.
#
# CloudWatch agent setup is INJECTed by the AWS provider from
# `providers/aws/cloudwatch-agent.json.tpl` (heredocs in YAML break over
# SSH due to indented terminators).
setup_commands:
    - aws s3 cp s3://{CODE_BUCKET}/code/src{CODE_SUFFIX}.tar.gz /tmp/src.tar.gz && mkdir -p ~/tessera-embeddings && tar -xzf /tmp/src.tar.gz -C ~/tessera-embeddings/ && rm /tmp/src.tar.gz
    - echo 'export PATH=/opt/tessera/venv/bin:$PATH' >> ~/.bashrc && echo 'export PYTHONPATH=$HOME/tessera-embeddings:$PYTHONPATH' >> ~/.bashrc

head_setup_commands: []
worker_setup_commands: []

# Ray start commands activate the pre-installed venv at /opt/tessera/venv.
# Adjust the venv path if your AMI puts it elsewhere.
#
# INJECT: launch-pacing environment — when the caller asks for it, the provider
# assigns LAUNCH_PACING_ENV on the head's `ray start` invocation below, so the
# autoscaler it spawns paces its EC2 launch requests against the account's shared
# RunInstances quota. Head only: a worker runs no autoscaler. The assignments must
# ride on the `ray start` command itself — Ray runs each entry as its own shell
# command over SSH, so an `export` on its own line reaches nothing.
head_start_ray_commands:
    - ray stop
    - ulimit -n 65536 && PYTHONPATH=$HOME/tessera-embeddings ray start --head --port=6379 --object-manager-port=8076 --autoscaling-config=~/ray_bootstrap_config.yaml --dashboard-host=0.0.0.0
worker_start_ray_commands:
    - ray stop
    - ulimit -n 65536 && PYTHONPATH=$HOME/tessera-embeddings ray start --address=$RAY_HEAD_IP:6379 --object-manager-port=8076
