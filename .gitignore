# Local scale-test artifacts (multi-GB icechunk stores) — never commit
scripts/scale_test_stores/
scripts/scale_test_results/
# NOT scripts/scale_tests/ — that is maintained source now. Ignoring the package
# meant a new benchmark added beside the tracked ones never showed up in git status.
scripts/scale_tests/**/results/
scripts/scale_tests/scale_testing_results.md
# Report output pasted from a terminal rather than redirected — the prompt
# ends up in the filename. Regenerate with `python -m scale_tests.report`.
scripts/scale_tests/(tessera-embeddings)*

# Local one-off analysis scripts kept out of the repo for now.
scripts/plot_corn_sample_500m_regions.py
