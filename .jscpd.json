{
  "path": ["src", "tests"],
  "format": ["python"],
  "ignore": ["tests/fixtures/**"],
  "maxGapLines": 3,
  "similarity": 0.8,
  "reporters": ["console"],
  "deadCode": {
    "entry": [
      "**/orchestration/**",
      "**/providers/**",
      "**/profiling/**",
      "**/__init__.py"
    ],
    "minConfidence": 85
  }
}
